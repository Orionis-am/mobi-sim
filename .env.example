TWILIO_ACCOUNT_SID=ACxxxxx        # compte trial Twilio (gratuit, sans CB)
TWILIO_AUTH_TOKEN=xxxxxxxxx
TWILIO_PHONE_NUMBER=+1415xxxxxxx  # numero Twilio trial offert (expediteur)
TWILIO_TEST_TO_NUMBER=+1xxxxxxxxx # numero mobile verifie de l'etudiant (destinataire des tests reels) - absent de docs/SUJET.md §6.2, ajoute ici car necessaire pour manual_twilio_check.py
TWILIO_VERIFY_SERVICE_SID=VAxxxxx # service Verify (cree une fois via client.verify.v2.services.create(...)) - necessaire pour manual_twilio_verify_check.py, contourne la restriction de template SMS des comptes trial (cf. REPORT.md)

OPENAI_API_KEY=sk-xxxxxxxxxx      # credit d'essai offert (Whisper uniquement)
OPENCELLID_API_KEY=xxxxxxxx       # gratuit sur opencellid.org - ou mode offline CSV

IPINFO_TOKEN=xxxxxxxxxx           # gratuit sur ipinfo.io (50k req/mois)

JWT_SECRET_KEY=un-secret-long-aleatoire
JWT_ALGORITHM=HS256
